FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY MyProject/NuGet.Config ./
COPY MyProject/common.props ./
COPY MyProject/src/ ./src/

# Restore
RUN dotnet restore src/MyProject.HttpApi.Host/MyProject.HttpApi.Host.csproj

# Build
RUN dotnet publish src/MyProject.HttpApi.Host/MyProject.HttpApi.Host.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

ENTRYPOINT ["dotnet", "MyProject.HttpApi.Host.dll"]
